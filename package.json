{
  "name": "scam-signal-engine",
  "version": "1.0.0",
  "description": "Explainable, deterministic, offline scam-signal scoring for messages and call transcripts — built for family-safety voice agents, chatbots and hotlines. Zero runtime dependencies, no API keys, no black box.",
  "type": "module",
  "license": "MIT",
  "author": "Mir Quadri",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "keywords": ["scam-detection", "fraud-prevention", "voice-clone", "imposter-scam", "family-safety", "mcp", "alexa"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
